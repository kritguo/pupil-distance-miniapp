page {
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  color: var(--ink);
}

.bg-glow {
  position: absolute;
  top: -140rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 900rpx;
  height: 520rpx;
  background: radial-gradient(circle at 50% 30%, #ffe0cb 0%, #fff4ec 46%, rgba(246, 247, 249, 0) 92%);
  pointer-events: none;
  z-index: 0;
}

.content {
  position: relative;
  z-index: 1;
  padding: 32rpx;
}

/* 头部 */
.profile-head {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 16rpx 8rpx 40rpx;
}
.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--o1), var(--o2));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(255, 94, 31, 0.3);
}
.avatar-text {
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
}
.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name {
  font-size: 38rpx;
  font-weight: 700;
}
.status-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--o-strong);
  background: var(--o-soft);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.status-badge.single {
  color: var(--conf-high-c);
  background: var(--conf-high-b);
}
.profile-sub {
  font-size: 26rpx;
  color: var(--ink-2);
}
.profile-sub.expire {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 记录卡 */
.record-card {
  padding: 12rpx 32rpx;
}
.record-head {
  padding: 22rpx 0 12rpx;
}
/* 左滑容器：露出右侧删除按钮 */
.record-swipe {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid var(--line);
}
.record-swipe:last-child {
  border-bottom: none;
}
.record-del {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--o-strong);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 1;
}
.record-item {
  position: relative;
  z-index: 2;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  transition: transform 0.22s ease;
}
.record-item.swiped {
  transform: translateX(-140rpx);
}
/* 展开 / 收起 */
.record-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0 12rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}
.record-toggle-ic {
  font-size: 28rpx;
  line-height: 1;
}
.record-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.record-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--o-strong);
  background: var(--o-soft);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.record-pd {
  font-size: 36rpx;
  font-weight: 800;
}
.record-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.record-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--ink-3);
}
.record-arrow {
  font-size: 40rpx;
  color: #c4c0b9;
}

.empty-record {
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.empty-text {
  font-size: 28rpx;
  color: var(--ink-3);
}
.empty-tip {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 设置 */
.menu-card {
  margin-top: 28rpx;
  padding: 6rpx 32rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.menu-item.last {
  border-bottom: none;
}
.menu-text {
  font-size: 30rpx;
  font-weight: 600;
}
.menu-arrow {
  font-size: 40rpx;
  color: #c4c0b9;
}

.version {
  display: block;
  text-align: center;
  margin-top: 52rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
