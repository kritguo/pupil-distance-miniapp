<scroll-view class="page" scroll-y>
  <view class="bg-glow"></view>
  <view class="content">
    <!-- 个人信息头部 -->
    <view class="profile-head">
      <view class="avatar"><text class="avatar-text">我</text></view>
      <view class="profile-info">
        <view class="name-row">
          <text class="name">微信用户</text>
          <text class="status-badge" wx:if="{{isUnlimited}}">年度会员</text>
          <text class="status-badge single" wx:elif="{{userStatus === 'single'}}">剩余 {{remainCount}} 次</text>
        </view>
        <text class="profile-sub">{{lastMeasureText}}</text>
        <text class="profile-sub expire" wx:if="{{annualExpireText}}">{{annualExpireText}}</text>
      </view>
    </view>

    <!-- 测量记录 -->
    <view class="u-card record-card">
      <view class="row-between record-head">
        <text class="u-card-title">测量记录</text>
        <text class="u-card-meta" wx:if="{{recordsCount > 0}}">共 {{recordsCount}} 条</text>
      </view>

      <view wx:if="{{records.length > 0}}">
        <view class="record-swipe" wx:for="{{visibleRecords}}" wx:key="time">
          <view class="record-del" catchtap="onDeleteRecord" data-id="{{item.id}}">删除</view>
          <view class="record-item {{item.id === swipeOpenId ? 'swiped' : ''}}"
                bindtap="viewRecord" data-record="{{item}}" data-id="{{item.id}}"
                bindtouchstart="onSwipeStart" bindtouchmove="onSwipeMove" bindtouchend="onSwipeEnd">
            <view class="record-main">
              <view class="record-line">
                <text class="record-name" wx:if="{{item.name}}">{{item.name}}</text>
                <text class="record-pd">{{item.totalPd}} <text class="record-unit">mm</text></text>
                <text class="u-conf {{item.confClass}}" wx:if="{{item.confidence}}">{{item.confidence}}</text>
              </view>
              <text class="record-sub">{{item.eyeStr ? '单眼 ' + item.eyeStr + ' · ' : ''}}{{item.shortDate}}</text>
            </view>
            <text class="record-arrow">›</text>
          </view>
        </view>

        <!-- 展开 / 收起 -->
        <view wx:if="{{recordsCount > 5}}" class="record-toggle" bindtap="onToggleRecords">
          <text>{{recordsExpanded ? '收起' : '展开全部 ' + recordsCount + ' 条'}}</text>
          <text class="record-toggle-ic">{{recordsExpanded ? '⌃' : '⌄'}}</text>
        </view>
      </view>

      <view class="empty-record" wx:else>
        <text class="empty-text">暂无记录</text>
        <text class="empty-tip">测量并解锁后，结果会自动保存在这里</text>
      </view>
    </view>

    <!-- 设置 -->
    <view class="u-card menu-card">
      <view class="menu-item" bindtap="goActivate">
        <text class="menu-text">卡密激活</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item last" bindtap="onAbout">
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <text class="version">版本 1.0.0</text>
  </view>
</scroll-view>
