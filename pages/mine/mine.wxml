<view class="page">
  <view class="header">
    <view class="avatar">
      <text class="avatar-text">我</text>
    </view>
    <text class="status-badge" wx:if="{{isUnlimited}}">年度会员</text>
    <text class="status-badge single" wx:elif="{{userStatus === 'single'}}">剩余 {{remainCount}} 次</text>
    <text class="status-sub" wx:if="{{annualExpireText}}">{{annualExpireText}}</text>
  </view>

  <!-- 测量记录 -->
  <view class="section">
    <text class="section-title">测量记录</text>

    <!-- 有记录 -->
    <view class="record-list" wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id" bindtap="viewRecord" data-record="{{item}}">
        <view class="record-main">
          <text class="record-pd">PD {{item.totalPd}}mm</text>
          <text class="record-face" wx:if="{{item.faceWidth}}">脸宽 {{item.faceWidth}}mm</text>
        </view>
        <view class="record-sub">
          <text class="record-time">{{item.timeStr}}</text>
          <text class="record-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 无记录 -->
    <view class="empty-record" wx:else>
      <text class="empty-text">暂无记录</text>
      <text class="empty-tip" wx:if="{{!isUnlimited}}">开通年度会员后可保存数据</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="section">
    <view class="menu-item" bindtap="goActivate">
      <text class="menu-text">卡密激活</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer">
    <text class="version">版本 1.0.0</text>
  </view>
</view>
