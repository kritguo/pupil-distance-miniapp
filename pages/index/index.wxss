page {
  background: #fff6ec;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, #fff6ec 0%, #f1f6ff 45%, #ffffff 100%);
  color: #111;
  font-family: "Avenir Next", "PingFang SC", "Helvetica Neue", sans-serif;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(10px);
  opacity: 0.8;
}

.orb-1 {
  top: -220rpx;
  right: -180rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 140, 90, 0.7), rgba(255, 140, 90, 0));
}

.orb-2 {
  bottom: -240rpx;
  left: -180rpx;
  background: radial-gradient(circle at 35% 35%, rgba(84, 160, 255, 0.55), rgba(84, 160, 255, 0));
}

.content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  padding-bottom: 40rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 0 60rpx;
  width: 100%;
}

.hero-badge {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 77, 46, 0.12);
  color: #ff4d2e;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.title {
  margin-top: 24rpx;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0e0f12;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.subtitle {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: rgba(14, 15, 18, 0.6);
}

.hero-pills {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.pill {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(14, 15, 18, 0.06);
  color: rgba(14, 15, 18, 0.7);
  font-size: 24rpx;
}

.btn-start {
  margin-top: 56rpx;
  padding: 30rpx 120rpx;
  background: linear-gradient(135deg, #ff5a3d, #ff8f3f);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
  white-space: nowrap;
  box-shadow: 0 18rpx 36rpx rgba(255, 110, 60, 0.3);
}

.btn-start::after {
  border: none;
}

.status-wrap {
  margin-top: 20rpx;
}

/* 用户状态提示 */
.status-tip {
  font-size: 24rpx;
  color: #16a34a;
}

.spotlight {
  width: 100%;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 20rpx 60rpx rgba(26, 26, 26, 0.08);
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.spotlight-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.spotlight-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0e0f12;
}

.spotlight-desc {
  font-size: 26rpx;
  color: rgba(14, 15, 18, 0.55);
}

.section {
  width: 100%;
  padding: 36rpx 0 8rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(14, 15, 18, 0.45);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  display: block;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-num {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: rgba(255, 90, 61, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #ff5a3d;
  flex-shrink: 0;
}

.step-text {
  font-size: 30rpx;
  color: rgba(14, 15, 18, 0.75);
  line-height: 1.5;
}

/* 测量项目列表 */
.param-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.param-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.param-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0e0f12;
}

.param-desc {
  font-size: 26rpx;
  color: rgba(14, 15, 18, 0.5);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 14rpx 28rpx;
  background: rgba(14, 15, 18, 0.06);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(14, 15, 18, 0.7);
}

.footer {
  padding: 28rpx 0 20rpx;
  text-align: center;
  width: 100%;
}

.notice {
  font-size: 20rpx;
  color: rgba(14, 15, 18, 0.35);
  line-height: 1.6;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-body {
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.modal-desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666;
}

.modal-price {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #000;
}

.modal-footer {
  padding: 0 48rpx 48rpx;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  background: #000;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}
