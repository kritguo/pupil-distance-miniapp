<view class="page">
  <view class="bg-glow"></view>

  <scroll-view class="body" scroll-y>
    <view class="content">
      <!-- HERO -->
      <view class="hero">
        <view class="hero-topline">
          <view class="u-badge"><view class="u-dot"></view>AI 智能测瞳距</view>
          <text wx:if="{{showMembershipStatus}}" class="status-tip">{{statusText}}</text>
        </view>
        <view class="title">
          <text class="title-line">快速测出瞳距</text>
        </view>
      </view>

      <!-- 三步卡 -->
      <view class="u-card steps-card">
        <view class="steps-head">
          <text class="steps-eyebrow">测量流程</text>
          <text class="steps-note">按提示完成即可</text>
        </view>
        <view class="steps">
          <view class="steps-line"></view>
          <view class="step">
            <view class="step-num">1</view>
            <text class="step-label">正脸拍照</text>
            <text class="step-sub">正对镜头</text>
          </view>
          <view class="step">
            <view class="step-num">2</view>
            <text class="step-label">AI 识别虹膜</text>
            <text class="step-sub">采集三次</text>
          </view>
          <view class="step">
            <view class="step-num">3</view>
            <text class="step-label">得到 PD 结果</text>
            <text class="step-sub">存到「我的」</text>
          </view>
        </view>
      </view>

      <!-- 开始测量（居中主按钮） -->
      <view class="cta-wrap">
        <button class="u-cta" hover-class="u-cta-press" hover-start-time="0" hover-stay-time="80" bindtap="onStart">开始测量</button>
      </view>

      <!-- 说明卡 -->
      <view class="u-card feat-card">
        <view class="feat">
          <view class="feat-ic list"></view>
          <view class="feat-text">
            <text class="feat-title">三次采集取中位数</text>
            <text class="feat-desc">总 / 单眼瞳距与可信度自动保存。</text>
          </view>
        </view>
        <view class="feat">
          <view class="feat-ic glasses"></view>
          <view class="feat-text">
            <text class="feat-title">配镜沟通参考</text>
            <text class="feat-desc">正式配镜以线下验光为准。</text>
          </view>
        </view>
        <view class="feat">
          <view class="feat-ic lock"></view>
          <view class="feat-text">
            <text class="feat-title">结果解锁</text>
            <text class="feat-desc">先测量，付费解锁结果。<text class="feat-more" catchtap="onPricingDetail">查看详情</text></text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showPricingDetail}}" class="pricing-backdrop" catchtap="closePricingDetail"></view>
  <view wx:if="{{showPricingDetail}}" class="pricing-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view>
        <text class="sheet-title">价格说明</text>
        <text class="sheet-sub">先测量，确认需要完整结果时再付费。</text>
      </view>
      <text class="sheet-close" catchtap="closePricingDetail">×</text>
    </view>

    <view class="price-plan">
      <view class="plan-main">
        <view>
          <text class="plan-name">单次测量</text>
          <text class="plan-tag">测量前不扣费</text>
        </view>
        <text class="plan-price">¥9.9</text>
      </view>
      <text class="plan-desc">拍 3 张自动取中位数，付费后解锁本次完整 PD 结果。</text>
    </view>

    <view class="price-plan">
      <view class="plan-main">
        <view>
          <text class="plan-name">年度会员</text>
          <text class="plan-tag">不限次数</text>
        </view>
        <text class="plan-price">¥19.9</text>
      </view>
      <text class="plan-desc">一年内不限次测量，适合多次复测或家庭使用。</text>
    </view>

    <button class="sheet-ok" bindtap="closePricingDetail">我知道了</button>
  </view>
</view>
