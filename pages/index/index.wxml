<view class="page">
  <view class="bg-glow"></view>

  <scroll-view class="body" scroll-y>
    <view class="content">
      <!-- HERO -->
      <view class="hero">
        <view class="u-badge"><view class="u-dot"></view>AI 智能测瞳距</view>
        <text class="title">正脸拍照,快速测出瞳距</text>
        <view class="status-wrap">
          <text wx:if="{{userStatus !== 'none'}}" class="status-tip">{{statusText}}</text>
        </view>
      </view>

      <!-- 三步完成 -->
      <view class="block">
        <text class="u-eyebrow">三步完成，快速得出结果</text>
        <view class="steps">
          <view class="steps-line"></view>
          <view class="step">
            <view class="step-num">1</view>
            <text class="step-label">正脸拍照</text>
          </view>
          <view class="step">
            <view class="step-num">2</view>
            <text class="step-label">AI 识别虹膜</text>
          </view>
          <view class="step">
            <view class="step-num">3</view>
            <text class="step-label">得到 PD 结果</text>
          </view>
        </view>
      </view>

      <!-- 你将得到 · 规格条 -->
      <view class="u-card spec-strip">
        <view class="spec-col">
          <text class="spec-name">瞳距 PD</text>
          <text class="spec-desc">总 / 单眼瞳距</text>
        </view>
        <view class="spec-divider"></view>
        <view class="spec-col">
          <text class="spec-name">三张统计</text>
          <text class="spec-desc">中位数 · 稳定度</text>
        </view>
        <view class="spec-divider"></view>
        <view class="spec-col">
          <text class="spec-name">配镜建议</text>
          <text class="spec-desc">结果含解读</text>
        </view>
      </view>

      <!-- 特性 -->
      <view class="u-card feat-card">
        <view class="feat">
          <view class="feat-ic cam"></view>
          <view class="feat-text">
            <text class="feat-title">AI 自动测量</text>
            <text class="feat-desc">正脸拍照即可，无需卡片、无需手动对齐。</text>
          </view>
        </view>
        <view class="feat">
          <view class="feat-ic shield"></view>
          <view class="feat-text">
            <text class="feat-title">智能修复</text>
            <text class="feat-desc">异常值自动拦截，结果波动时提示重测。</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 吸底操作条（与 tabBar 堆叠，不浮动遮挡） -->
  <view class="home-actionbar">
    <view class="u-price-line">拍 3 张自动取中位数，结果更稳 · 一次测量 <text class="u-strong">¥9.9</text></view>
    <button class="u-cta" bindtap="onStart">开始测量</button>
  </view>
</view>
