page {
  background: #000;
}

.page {
  height: 100vh;
  display: flex;
  background: #000;
  color: #fff;
  overflow: hidden;
}

.page.capture-mode,
.page {
  display: block;
}

/* ========== 拍照阶段 - 全屏相机 ========== */
.camera-fullscreen {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.camera-fullscreen .camera {
  width: 100%;
  height: 100%;
}

.camera-tip {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  padding: 12rpx 32rpx;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10px);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
  z-index: 10;
}

/* 顶部操作栏 */
.top-bar {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  padding: 0 32rpx;
  display: flex;
  justify-content: space-between;
  z-index: 20;
}

.btn-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  border-radius: 50%;
}

.icon-arrow {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  margin-top: -4rpx;
}

.icon-switch {
  font-size: 40rpx;
  color: #fff;
}

/* 人脸对准区域 */
.face-guide {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -55%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
}

.face-outline {
  width: 400rpx;
  height: 520rpx;
  border: 4rpx dashed rgba(255, 255, 255, 0.6);
  border-radius: 200rpx 200rpx 160rpx 160rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-hint {
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  /* 银行卡比例 85.6:53.98 ≈ 1.586:1 */
  width: 200rpx;
  height: 126rpx;  /* 200 / 1.586 ≈ 126 */
  border: 3rpx solid rgba(255, 77, 79, 0.9);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 77, 79, 0.08);
}

/* 鼻子中线引导 */
.center-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  background: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(64, 169, 255, 0.8) 20%,
    rgba(64, 169, 255, 0.8) 80%,
    transparent 100%
  );
  z-index: 6;
}

.center-line-hint {
  position: absolute;
  bottom: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: rgba(64, 169, 255, 0.9);
  white-space: nowrap;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

/* 浮层操作区 */
.capture-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 48rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

.capture-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  line-height: 1.5;
}

/* 底部按钮区域 */
.capture-bottom {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
}

.btn-icon-placeholder {
  width: 80rpx;
  height: 80rpx;
}

/* 拍照按钮 - 相机风格 */
.btn-capture {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: transparent;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.btn-capture::after {
  border: none;
}

.btn-capture-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #fff;
}

.btn-capture:active .btn-capture-inner {
  background: rgba(255, 255, 255, 0.7);
  transform: scale(0.95);
}

/* ========== 调整阶段 - 全屏照片 ========== */
.main-area-fullscreen {
  position: relative;
  width: 100vw;
  height: 100vh;
}

/* 全屏照片 */
.photo-fullscreen {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 调试：人脸框 */
.debug-face-rect {
  position: absolute;
  border: 3px solid yellow;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 100;
}

/* 调试：屏幕中心十字线 */
.debug-center-cross-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: lime;
  z-index: 101;
  pointer-events: none;
}
.debug-center-cross-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background: lime;
  z-index: 101;
  pointer-events: none;
}

/* 覆盖层 - 满屏可拖拽区域 */
.overlay-fullscreen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.pupil-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
}

/* 调整页面顶部栏 */
.adjust-top-bar {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  left: 32rpx;
  z-index: 20;
}

/* 标记点 */
.point {
  width: 64px;
  height: 88px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
  overflow: visible;
}

.point-dot {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 3px solid #fff;
  box-shadow: 0 0 0 1px rgba(0,0,0,0.3), 0 4px 12px rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.point-dot::after {
  content: '';
  width: 6px;
  height: 6px;
  background: #fff;
  border-radius: 50%;
}

.left-eye .point-dot {
  background: rgba(59, 130, 246, 0.8);
}

.right-eye .point-dot {
  background: rgba(239, 68, 68, 0.8);
}

.drag-hint {
  position: absolute;
  top: 44px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  pointer-events: none;
}

.drag-icon {
  width: 32rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 10rpx 0 rgba(255, 255, 255, 0.35), 0 -10rpx 0 rgba(255, 255, 255, 0.35);
}

.drag-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  white-space: nowrap;
}

/* 标记线 */
.line-wrap {
  width: 44px;
  height: 100%;
  position: relative;
}

.line {
  width: 2px;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.9);
}

.line-wrap.center .line {
  background: #3b82f6;
  box-shadow: 0 0 8px rgba(59, 130, 246, 0.5);
}

.line-wrap.card .line {
  background: #22c55e;
  box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
}

/* 脸部边缘线 - 橙色 */
.line-wrap.face-edge .line {
  background: #f97316;
  box-shadow: 0 0 8px rgba(249, 115, 22, 0.5);
}

.line-tag {
  position: absolute;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  padding: 4px 10px;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  border-radius: 4px;
  color: #fff;
  font-size: 11px;
  white-space: nowrap;
}

/* ========== 底部悬浮面板 - 透明风格 ========== */
.floating-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28rpx 32rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(20px);
  z-index: 100;
}

.floating-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.step-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.step-num-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.step-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.dot.active {
  background: #fff;
  width: 24rpx;
  border-radius: 6rpx;
}

.dot.done {
  background: rgba(255, 255, 255, 0.6);
}

.floating-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.skip-face-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -12rpx;
  margin-bottom: 16rpx;
}

.skip-face-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.08);
}

.skip-face-btn:active {
  background: rgba(255, 255, 255, 0.18);
}

.card-config {
  padding: 16rpx 0 24rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  margin-bottom: 24rpx;
}

.card-config-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.card-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.card-option {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.card-option.selected {
  background: rgba(255, 255, 255, 0.85);
  color: #000;
}

.card-config-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.floating-actions {
  display: flex;
  gap: 20rpx;
}

.btn-float-primary {
  flex: 1;
  padding: 24rpx 0;
  background: #fff;
  color: #000;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  text-align: center;
}

.btn-float-primary:active {
  background: rgba(255, 255, 255, 0.85);
}

.btn-float-secondary {
  flex: 1;
  padding: 24rpx 0;
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  border-radius: 16rpx;
  text-align: center;
}

.btn-float-secondary:active {
  background: rgba(255, 255, 255, 0.25);
}
