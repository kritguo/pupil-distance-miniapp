page {
  background: #000;
}

.page.capture-mode {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.camera-fullscreen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.camera {
  width: 100%;
  height: 100%;
}

/* 顶/底 深色蒙版 */
.scrim {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 2;
}
.scrim-top {
  top: 0;
  height: 460rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
}
.scrim-bottom {
  bottom: 0;
  height: 560rpx;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.66), rgba(0, 0, 0, 0));
}

/* ===== 顶部 ===== */
.cap-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 4;
  padding-top: calc(env(safe-area-inset-top) + 16rpx);
  color: #fff;
  text-align: center;
}
.top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 32rpx;
}
.btn-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-arrow {
  color: #fff;
  font-size: 48rpx;
  line-height: 1;
}
.btn-icon-placeholder {
  width: 72rpx;
  height: 72rpx;
}
.shot-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.shot-progress.precision {
  padding-top: 96rpx;
}
.mode-status {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.35);
}
.shot-progress-text {
  font-size: 32rpx;
  font-weight: 700;
}
.shot-dots {
  display: flex;
  gap: 12rpx;
}
.shot-dot {
  width: 44rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.4);
}
.shot-dot.on {
  background: #fff;
}
/* ===== 人脸引导框 ===== */
.face-guide {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 整体在垂直居中基础上下移，贴合手持前置时脸自然落点（眼线约 54%） */
  transform: translateY(1%);
  z-index: 3;
}
.face-outline {
  position: relative;
  width: 420rpx;
  height: 560rpx;
  border: 5rpx dashed rgba(255, 255, 255, 0.9);
  border-radius: 50% / 46%;
}
.face-outline.precision {
  border-color: rgba(86, 194, 255, 0.95);
}
.eye-line {
  position: absolute;
  top: 250rpx;
  left: 8%;
  right: 8%;
  height: 0;
  border-top: 4rpx dashed rgba(255, 255, 255, 0.8);
}
.eye-mark {
  position: absolute;
  top: 218rpx;
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}
/* 眼圈中心间距 = 头宽(420rpx) × ≈0.38 ≈ 160rpx，比真实略收，更贴合视觉 */
.eye-mark.left { left: 98rpx; }
.eye-mark.right { right: 98rpx; }

.card-outline {
  position: absolute;
  top: 28rpx;
  left: 50%;
  width: 300rpx;
  height: 150rpx;
  transform: translateX(-50%);
  border: 4rpx dashed rgba(86, 194, 255, 0.95);
  border-radius: 12rpx;
  box-sizing: border-box;
}
.card-label {
  position: absolute;
  left: 0;
  right: 0;
  top: 52rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.96);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.55);
}
.card-corner {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-color: #56c2ff;
}
.card-corner.tl {
  left: -4rpx;
  top: -4rpx;
  border-left: 6rpx solid #56c2ff;
  border-top: 6rpx solid #56c2ff;
}
.card-corner.tr {
  right: -4rpx;
  top: -4rpx;
  border-right: 6rpx solid #56c2ff;
  border-top: 6rpx solid #56c2ff;
}
.card-corner.bl {
  left: -4rpx;
  bottom: -4rpx;
  border-left: 6rpx solid #56c2ff;
  border-bottom: 6rpx solid #56c2ff;
}
.card-corner.br {
  right: -4rpx;
  bottom: -4rpx;
  border-right: 6rpx solid #56c2ff;
  border-bottom: 6rpx solid #56c2ff;
}

/* 引导语：主+副两行一起放在椭圆上方（合并原底部的距离提示） */
.guide-text {
  margin-bottom: 40rpx;
  text-align: center;
  padding: 0 60rpx;
  z-index: 4;
}
.guide-main {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}
.guide-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}

/* ===== 底部 ===== */
.cap-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 4;
  padding-bottom: calc(env(safe-area-inset-bottom) + 34rpx);
}
.capture-guide {
  width: 620rpx;
  margin: 0 auto 28rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  color: #111;
  background: rgba(255, 255, 255, 0.94);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}
.capture-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 76rpx;
}
.btn-round {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-switch {
  color: #fff;
  font-size: 48rpx;
  line-height: 1;
}
.icon-help {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}
.btn-capture {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-capture-inner {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: #fff;
}
