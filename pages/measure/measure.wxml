<view class="page capture-mode">
  <!-- 全屏相机 -->
  <view class="camera-fullscreen">
    <camera class="camera" device-position="{{cameraPosition}}" flash="off"></camera>

    <!-- 顶/底 深色蒙版，保证文字可读 -->
    <view class="scrim scrim-top"></view>
    <view class="scrim scrim-bottom"></view>

    <!-- ===== 顶部 ===== -->
    <view class="cap-top">
      <view class="top-row">
        <view class="btn-icon" bindtap="goBack">
          <text class="icon-arrow">‹</text>
        </view>
        <view class="shot-progress">
          <text class="shot-progress-text">第 {{shotIndex + 1}} / {{totalShots}} 张</text>
          <view class="shot-dots">
            <view class="shot-dot {{shotIndex >= 1 ? 'on' : ''}}"></view>
            <view class="shot-dot {{shotIndex >= 2 ? 'on' : ''}}"></view>
            <view class="shot-dot {{shotIndex >= 3 ? 'on' : ''}}"></view>
          </view>
        </view>
        <view class="btn-icon-placeholder"></view>
      </view>
      <!-- 摘镜提示 chip -->
      <view class="glasses-chip">⚠️ 摘掉眼镜测得更准</view>
    </view>

    <!-- ===== 人脸引导框（含引导语，整体居中偏下，贴合手持时脸的位置） ===== -->
    <view class="face-guide">
      <view class="guide-text">
        <view class="guide-main">把瞳孔对准两个圈、双眼对齐横线</view>
        <view class="guide-sub">举到与眼睛同高 · 约一臂距离（约 50cm）</view>
      </view>
      <view class="face-outline">
        <view class="eye-line"></view>
        <view class="eye-mark left"></view>
        <view class="eye-mark right"></view>
      </view>
    </view>

    <!-- ===== 底部 ===== -->
    <view class="cap-bottom">
      <view class="capture-bottom">
        <view class="btn-round" bindtap="switchCamera">
          <text class="icon-switch">⟳</text>
        </view>
        <view class="btn-capture" bindtap="takePhoto">
          <view class="btn-capture-inner"></view>
        </view>
        <view class="btn-round" bindtap="onHelp">
          <text class="icon-help">?</text>
        </view>
      </view>
      <view class="cap-sub">对准后点击快门拍摄，一次测量需拍 3 张</view>
    </view>
  </view>
</view>
