page {
  background: #fff8f3;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff1e6 0%, #fff8f3 30%, #f7f8fa 100%);
  color: var(--ink);
}

/* 空状态 */
.empty {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--ink-3);
}
.empty-btn {
  width: 360rpx !important;
  margin: 0 auto !important;
}

.content {
  padding: 24rpx 32rpx 0;
}
.content > .u-card {
  margin-top: 24rpx;
}

/* 状态药丸 */
/* 已保存提示 + 测量对象命名 */
.saved-block {
  margin-bottom: 8rpx;
}
.saved-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.saved-line-text {
  font-size: 24rpx;
  color: var(--conf-high-c);
}
.saved-line-arrow {
  font-size: 26rpx;
  color: var(--conf-high-c);
}
.name-line {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: var(--o-soft);
  border-radius: 999rpx;
}
.name-line-label {
  font-size: 25rpx;
  color: var(--ink-3);
}
.name-line-value {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}
.name-line-value.is-empty {
  font-weight: 400;
  color: var(--ink-3);
}
.name-line-edit {
  font-size: 28rpx;
  color: var(--o2);
}

/* 可信度为「中」的免费重测提示 */
.retest-tip {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--conf-mid-b);
  border-radius: 24rpx;
}
.retest-tip-body {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.retest-tip-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--conf-mid-c);
}
.retest-tip-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--conf-mid-c);
  line-height: 1.4;
}
.retest-tip-btn {
  flex: 0 0 auto;
  width: auto !important;
  margin: 0 !important;
  height: 64rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, var(--o1), var(--o2));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
.retest-tip-btn::after { border: none; }

/* 主结果 */
.hero {
  text-align: center;
  padding: 28rpx 0 8rpx;
}
.hero-label {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}
.hero-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.hero-value {
  font-size: 148rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -4rpx;
  color: #0e0f12;
}
.hero-value.masked {
  color: var(--ink-3);
  letter-spacing: 4rpx;
}
.hero-unit {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink-2);
}
.hero-source {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 通用行 */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.u-card-sub {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-3);
}
.u-card-meta {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 波动点阵 */
.spread {
  margin-top: 30rpx;
}
.spread-head {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: var(--ink-3);
}
.spread-diff {
  color: var(--ink);
  font-weight: 700;
}
.spread-track {
  position: relative;
  height: 76rpx;
  margin-top: 12rpx;
}
.spread-bar {
  position: absolute;
  top: 20rpx;
  left: 10%;
  right: 10%;
  height: 6rpx;
  background: #ffcaa6;
  border-radius: 3rpx;
}
.spread-dot {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  text-align: center;
}
.spread-dot-pt {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin: 12rpx auto 0;
  background: #c9c4bd;
}
.spread-dot.hi .spread-dot-pt {
  width: 28rpx;
  height: 28rpx;
  margin-top: 8rpx;
  background: var(--o2);
  border: 6rpx solid #fff;
  box-shadow: 0 0 0 4rpx var(--o2);
}
.spread-dot-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.spread-dot.hi .spread-dot-label {
  color: var(--o2);
  font-weight: 700;
}
.spread-warning {
  display: block;
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--o-strong);
}

/* 单眼 / 近用 */
.eye-row {
  display: flex;
  align-items: stretch;
  margin-top: 22rpx;
}
.eye-col {
  flex: 1;
  text-align: center;
}
.eye-label {
  display: block;
  font-size: 25rpx;
  color: var(--ink-3);
}
.eye-value {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
}
.eye-value.sm {
  font-size: 34rpx;
}
.eye-value.masked {
  color: var(--ink-3);
}
.eye-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.eye-divider {
  width: 1rpx;
  background: var(--line);
}

/* key-value 列表 */
.kv-list {
  margin-top: 16rpx;
}
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.kv:last-child {
  border-bottom: none;
}
.kv-k {
  font-size: 27rpx;
  color: var(--ink-2);
}
.kv-v {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
}
.kv-v.hl { color: var(--o-strong); }
.kv-v.masked { color: var(--ink-3); font-weight: 600; }

.progress-hint {
  margin-top: 22rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 三张明细 */
.detail-title {
  display: block;
  margin-bottom: 6rpx;
}
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-idx {
  font-size: 27rpx;
  color: var(--ink-2);
}
.detail-val {
  font-size: 29rpx;
  font-weight: 700;
}
.detail-val.masked { color: var(--ink-3); font-weight: 600; }

.card-note {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.5;
}
.card-note.warn {
  color: var(--conf-mid-c);
}

/* 配镜下单参数 */
.order-box {
  margin-top: 20rpx;
  background: var(--o-tint);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.order-cap {
  font-size: 24rpx;
  color: var(--ink-3);
}
.order-val {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
}
.order-copy {
  flex: 0 0 auto;
  height: 68rpx;
  padding: 0 34rpx;
  border-radius: 34rpx;
  background: var(--o2);
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.order-copy::after { border: none; }

.tip-list {
  margin-top: 24rpx;
}
.tip-item {
  display: flex;
  gap: 16rpx;
}
.tip-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--o2);
  margin-top: 14rpx;
}
.tip-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ink-2);
}

/* 镜片建议输入 */
.lens-hint {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.lens-eye-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.lens-eye-label {
  flex: 0 0 56rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink-2);
}
.lens-field {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #f6f7f9;
  border-radius: 18rpx;
  padding: 0 20rpx;
}
.lens-field-unit {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-left: 8rpx;
}
.lens-input {
  flex: 1;
  height: 80rpx;
  background: transparent;
  padding: 0;
  font-size: 27rpx;
}
.lens-usage-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}
.lens-usage-label {
  font-size: 26rpx;
  color: var(--ink-3);
}
.usage-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.usage-option {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f1f2f4;
  font-size: 26rpx;
  color: var(--ink-2);
}
.usage-option.selected {
  background: var(--o-soft);
  color: var(--o-strong);
  font-weight: 700;
}
.lens-calc {
  margin-top: 56rpx;
  height: 84rpx;
  font-size: 29rpx;
}
.lens-result {
  margin-top: 8rpx;
}

.notice {
  display: block;
  text-align: center;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.actionbar-spacer {
  height: 200rpx;
}

/* 吸底操作区 */
.bar-btns {
  display: flex;
  gap: 24rpx;
}
.bar-ghost { flex: 1; height: 96rpx; }
.bar-primary { flex: 1.3; height: 96rpx; }

/* ===== 付费弹窗 ===== */
.pay-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.pay-modal {
  width: 620rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx;
}
.pay-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pay-modal-title {
  font-size: 34rpx;
  font-weight: 700;
}
.pay-modal-close {
  font-size: 44rpx;
  color: var(--ink-3);
  line-height: 1;
}
.pay-plans {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pay-plan {
  position: relative;
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
}
.pay-plan.selected {
  border-color: var(--o2);
  background: var(--o-tint);
}
.plan-badge {
  position: absolute;
  top: -2rpx;
  right: 28rpx;
  background: var(--o2);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 0 0 16rpx 16rpx;
}
.plan-price {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--o-strong);
}
.plan-name {
  margin-left: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.plan-features {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.plan-feature {
  font-size: 25rpx;
  color: var(--ink-2);
}
.pay-btn {
  margin-top: 28rpx;
  width: 100% !important;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, var(--o1), var(--o2));
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(255, 94, 31, 0.3);
}
.pay-btn::after { border: none; }
