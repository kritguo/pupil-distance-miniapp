<scroll-view class="page" scroll-y>
  <view wx:if="{{empty}}" class="empty">
    <text class="empty-text">暂无测量结果</text>
    <button class="u-cta empty-btn" bindtap="onRetake">开始测量</button>
  </view>

  <view wx:else class="content">
    <!-- 已保存提示 + 测量对象命名 -->
    <view wx:if="{{isPaid}}" class="saved-block">
      <view class="saved-line" bindtap="onViewSaved">
        <text class="saved-line-text">本次结果已保存于个人中心，点此查看</text>
        <text class="saved-line-arrow">›</text>
      </view>
      <view class="name-line" bindtap="onEditName">
        <text class="name-line-label">测量对象</text>
        <text class="name-line-value {{measureName ? '' : 'is-empty'}}">{{measureName || '点此标注（给谁测的）'}}</text>
        <text class="name-line-edit">✎</text>
      </view>
    </view>

    <!-- 主结果：总瞳距 -->
    <view class="hero">
      <text class="hero-label">总瞳距 PD{{displayResult.pdBasis === 'far' ? '（远用）' : ''}}</text>
      <view class="hero-value-row">
        <text class="hero-value {{!isPaid ? 'masked' : ''}}">{{isPaid ? displayResult.totalPd : '••'}}</text>
        <text class="hero-unit">mm</text>
      </view>
      <text class="hero-source">{{displayResultSource}}</text>
    </view>

    <!-- 可信度 + 波动 -->
    <view class="u-card">
      <view class="row-between">
        <text class="u-card-title">结果可信度</text>
        <!-- 可信度不打码：这是付费决策最需要的质量证据 -->
        <text class="u-conf {{displayResult.confidence === '高' ? 'high' : (displayResult.confidence === '低' ? 'low' : 'mid')}}">{{displayResult.confidence}}</text>
      </view>

      <!-- 波动点阵图（形状对未付费可见作质量证据；点上的 PD 数值仅已付费可见） -->
      <view class="spread" wx:if="{{spreadDots.length > 1}}">
        <view class="spread-head">
          <text class="spread-head-label">三张最大相差</text>
          <text class="spread-diff">{{spreadMaxDiff}} mm</text>
        </view>
        <view class="spread-track">
          <view class="spread-bar"></view>
          <view class="spread-dot {{item.hi ? 'hi' : ''}}" wx:for="{{spreadDots}}" wx:key="id" style="left:{{item.left}}%">
            <view class="spread-dot-pt"></view>
            <text class="spread-dot-label" wx:if="{{isPaid}}">{{item.pd}}</text>
          </view>
        </view>
      </view>

      <text class="spread-warning" wx:if="{{isPaid && medianWarning}}">{{medianWarning}}</text>
    </view>

    <!-- 付费后统一邀请精度复测：iOS 去 App，安卓/其他走卡片校验 -->
    <view wx:if="{{showPrecisionInvite}}" class="precision-invite {{displayResult.confidence !== '高' ? 'strong' : ''}}">
      <view class="precision-invite-head">
        <text class="precision-invite-title">{{precisionInvite.title}}</text>
        <text class="precision-invite-tag {{precisionInvite.planType === 'annual' ? 'member' : 'single'}}">{{precisionInvite.planLabel}}</text>
      </view>
      <text class="precision-invite-desc">{{precisionInvite.desc}}</text>
      <text wx:if="{{displayResult.confidence !== '高'}}" class="precision-invite-alert">本次可信度未达「高」，建议优先完成精度复测。</text>
      <button class="precision-invite-btn" bindtap="onPrecisionRetest">{{retestRequesting ? '处理中...' : precisionInvite.buttonText}}</button>
    </view>

    <!-- 单眼瞳距 -->
    <view class="u-card">
      <text class="u-card-sub">单眼瞳距 PD</text>
      <view class="eye-row">
        <view class="eye-col">
          <text class="eye-label">左眼</text>
          <text class="eye-value {{!isPaid ? 'masked' : ''}}">{{isPaid ? displayResult.leftPd : '••.•'}} <text class="eye-unit">mm</text></text>
        </view>
        <view class="eye-divider"></view>
        <view class="eye-col">
          <text class="eye-label">右眼</text>
          <text class="eye-value {{!isPaid ? 'masked' : ''}}">{{isPaid ? displayResult.rightPd : '••.•'}} <text class="eye-unit">mm</text></text>
        </view>
      </view>
    </view>

    <!-- 近用参考 -->
    <view class="u-card" wx:if="{{displayResult.nearTotalPd}}">
      <text class="u-card-sub">近用参考 PD</text>
      <view class="eye-row">
        <view class="eye-col">
          <text class="eye-label">总 PD</text>
          <text class="eye-value sm {{!isPaid ? 'masked' : ''}}">{{isPaid ? displayResult.nearTotalPd : '••.•'}}</text>
        </view>
        <view class="eye-divider"></view>
        <view class="eye-col">
          <text class="eye-label">左眼</text>
          <text class="eye-value sm {{!isPaid ? 'masked' : ''}}">{{isPaid ? displayResult.nearLeftPd : '••.•'}}</text>
        </view>
        <view class="eye-divider"></view>
        <view class="eye-col">
          <text class="eye-label">右眼</text>
          <text class="eye-value sm {{!isPaid ? 'masked' : ''}}">{{isPaid ? displayResult.nearRightPd : '••.•'}}</text>
        </view>
      </view>
    </view>

    <!-- 中位数推荐 -->
    <view class="u-card" wx:if="{{medianResult && !fromRecord}}">
      <view class="row-between">
        <text class="u-card-title">中位数推荐</text>
        <text class="u-card-meta">基于 {{medianCount}} 次测量</text>
      </view>
      <view class="kv-list">
        <view class="kv"><text class="kv-k">总瞳距</text><text class="kv-v {{!isPaid ? 'masked' : ''}}">{{isPaid ? medianResult.totalPd : '••.•'}} mm</text></view>
        <view class="kv"><text class="kv-k">左眼 PD</text><text class="kv-v {{!isPaid ? 'masked' : ''}}">{{isPaid ? medianResult.leftPd : '••.•'}} mm</text></view>
        <view class="kv"><text class="kv-k">右眼 PD</text><text class="kv-v {{!isPaid ? 'masked' : ''}}">{{isPaid ? medianResult.rightPd : '••.•'}} mm</text></view>
        <view class="kv" wx:if="{{medianResult.nearTotalPd}}"><text class="kv-k">近用总 PD</text><text class="kv-v {{!isPaid ? 'masked' : ''}}">{{isPaid ? medianResult.nearTotalPd : '••.•'}} mm</text></view>
        <view class="kv" wx:if="{{medianResult.faceWidth}}"><text class="kv-k">脸宽</text><text class="kv-v {{!isPaid ? 'masked' : ''}}">{{isPaid ? medianResult.faceWidth : '••.•'}} mm</text></view>
        <view class="kv"><text class="kv-k">三次波动</text><text class="kv-v">{{medianResult.totalSpread}} mm · {{medianResult.consistency}}</text></view>
      </view>
    </view>

    <view class="progress-hint" wx:if="{{progressText && !fromRecord}}">{{progressText}}</view>

    <!-- 三张拍照明细 -->
    <view class="u-card" wx:if="{{trialMode && trialResults.length}}">
      <text class="u-card-title detail-title">三张拍照明细</text>
      <view class="detail-row" wx:for="{{trialResults}}" wx:key="timestamp" wx:for-index="index">
        <text class="detail-idx">第 {{index + 1}} 张</text>
        <text class="detail-val {{!isPaid ? 'masked' : ''}}">{{isPaid ? item.totalPd : '••.•'}} mm</text>
      </view>
    </view>

    <!-- 配镜建议（下单参数 + 复制） -->
    <view class="u-card" wx:if="{{isPaid}}">
      <text class="u-card-title">配镜建议</text>
      <view class="order-box">
        <view class="order-info">
          <text class="order-cap">配镜下单时提供</text>
          <text class="order-val">总 {{displayResult.totalPd}} · 左 {{displayResult.leftPd}} · 右 {{displayResult.rightPd}} mm</text>
        </view>
        <button class="order-copy" bindtap="onCopy">复制</button>
      </view>
      <view class="tip-list">
        <view class="tip-item"><view class="tip-dot"></view><text class="tip-text">瞳距仅为配镜参数之一，镜片度数请以专业验光结果为准。</text></view>
      </view>
    </view>

    <!-- 镜片建议（按验光单分左右眼，球镜+散光） -->
    <view class="u-card" wx:if="{{isPaid}}">
      <text class="u-card-title">镜片建议</text>
      <text class="lens-hint">照验光单填左右眼度数，散光选填</text>

      <view class="lens-eye-row">
        <text class="lens-eye-label">左眼</text>
        <view class="lens-field">
          <input class="lens-input" type="digit" placeholder="球镜度数" value="{{sphL}}" bindinput="onLensInput" data-field="sphL" />
          <text class="lens-field-unit">度</text>
        </view>
        <view class="lens-field">
          <input class="lens-input" type="digit" placeholder="散光(选填)" value="{{cylL}}" bindinput="onLensInput" data-field="cylL" />
          <text class="lens-field-unit">度</text>
        </view>
      </view>
      <view class="lens-eye-row">
        <text class="lens-eye-label">右眼</text>
        <view class="lens-field">
          <input class="lens-input" type="digit" placeholder="球镜度数" value="{{sphR}}" bindinput="onLensInput" data-field="sphR" />
          <text class="lens-field-unit">度</text>
        </view>
        <view class="lens-field">
          <input class="lens-input" type="digit" placeholder="散光(选填)" value="{{cylR}}" bindinput="onLensInput" data-field="cylR" />
          <text class="lens-field-unit">度</text>
        </view>
      </view>

      <view class="lens-usage-row">
        <text class="lens-usage-label">用途</text>
        <radio-group class="usage-group" bindchange="onUsageChange">
          <label wx:for="{{usageOptions}}" wx:key="value" class="usage-option {{selectedUsage === item.value ? 'selected' : ''}}">
            <radio value="{{item.value}}" checked="{{selectedUsage === item.value}}" hidden />
            <text>{{item.label}}</text>
          </label>
        </radio-group>
      </view>
      <button class="u-cta ghost lens-calc" bindtap="calcLensAdvice">获取建议</button>

      <view wx:if="{{lensAdvice}}" class="kv-list lens-result">
        <view class="kv"><text class="kv-k">有效度数(球+散)</text><text class="kv-v">左 {{lensAdvice.effL}} / 右 {{lensAdvice.effR}} 度</text></view>
        <view class="kv"><text class="kv-k">推荐折射率</text><text class="kv-v">{{lensAdvice.index}}（{{lensAdvice.indexName}}）</text></view>
        <view class="kv"><text class="kv-k">镜片面型</text><text class="kv-v">{{lensAdvice.lensShape}}</text></view>
        <view class="kv"><text class="kv-k">推荐膜层</text><text class="kv-v">{{lensAdvice.coating}}</text></view>
        <view class="kv" wx:if="{{lensAdvice.pd}}"><text class="kv-k">光心瞳距</text><text class="kv-v">{{lensAdvice.pd}} mm（本次测得）</text></view>
      </view>
      <text class="card-note" wx:if="{{lensAdvice}}">{{lensAdvice.usageNote}}</text>
      <text class="card-note warn" wx:if="{{lensAdvice && lensAdvice.aniso}}">⚠️ 左右眼有效度数相差 {{lensAdvice.anisoDiff}} 度，属不等视，建议尽量选薄镜片、并务必精准对准瞳距。</text>
      <text class="card-note" wx:if="{{lensAdvice}}">{{lensAdvice.disclaimer}}</text>
    </view>

    <!-- 未付费：解锁后可见内容预告（让用户自己得出「值」的结论） -->
    <view class="u-card" wx:if="{{!isPaid}}">
      <text class="u-card-title">解锁后还可查看</text>
      <view class="tip-list">
        <view class="tip-item"><view class="tip-dot"></view><text class="tip-text">总瞳距与左右眼精确数值</text></view>
        <view class="tip-item"><view class="tip-dot"></view><text class="tip-text">配镜下单参数，一键复制给商家</text></view>
        <view class="tip-item"><view class="tip-dot"></view><text class="tip-text">镜片折射率与膜层建议</text></view>
        <view class="tip-item"><view class="tip-dot"></view><text class="tip-text">结果保存到个人中心，随时回看</text></view>
      </view>
    </view>

    <text class="notice">仅供参考，不替代专业验光</text>
    <view class="actionbar-spacer"></view>
  </view>
</scroll-view>

<!-- 吸底操作区 -->
<view class="u-actionbar" wx:if="{{isPaid}}">
  <view class="bar-btns">
    <button class="u-cta ghost bar-ghost" bindtap="onBackHome">返回首页</button>
    <button class="u-cta bar-primary" bindtap="onRetake">{{nextMeasureText}}</button>
  </view>
</view>

<!-- 未付费吸底解锁栏（弹窗收起后仍可随时解锁） -->
<view class="u-actionbar" wx:if="{{!isPaid && !showPayModal && !empty}}">
  <button class="u-cta" bindtap="openPayModal">¥9.9 解锁本次结果</button>
</view>

<!-- 付费选择弹窗 -->
<view class="pay-modal-mask" wx:if="{{showPayModal}}">
  <view class="pay-modal">
    <view class="pay-modal-header">
      <text class="pay-modal-title">解锁测量结果</text>
      <text class="pay-modal-close" bindtap="closePayModal">×</text>
    </view>
    <text class="pay-modal-conf">已测出可信度「{{displayResult.confidence}}」的结果，支付后立即查看</text>

    <view class="pay-plans">
      <view class="pay-plan {{selectedPlan === 'single' ? 'selected' : ''}}" bindtap="selectPlan" data-plan="single">
        <text class="plan-price">¥9.9</text>
        <text class="plan-name">一次测量</text>
        <view class="plan-features">
          <text class="plan-feature">· 拍 3 张照片，自动取中位数</text>
          <text class="plan-feature">· 解锁本次结果与配镜建议</text>
          <text class="plan-feature">· 赠送一次精度复测权益</text>
        </view>
      </view>

      <view class="pay-plan {{selectedPlan === 'unlimited' ? 'selected' : ''}}" bindtap="selectPlan" data-plan="unlimited">
        <view class="plan-badge">推荐</view>
        <text class="plan-price">¥19.9</text>
        <text class="plan-name">年度会员</text>
        <view class="plan-features">
          <text class="plan-feature">· 一年内不限次数</text>
          <text class="plan-feature">· 精度复测不限次数</text>
          <text class="plan-feature">· 中位数推荐 · 随时回看</text>
        </view>
      </view>
    </view>

    <button class="pay-btn" bindtap="onPay">确认支付</button>
  </view>
</view>
